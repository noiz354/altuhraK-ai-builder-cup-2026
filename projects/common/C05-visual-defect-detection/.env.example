# C05 environment template.
# Copy to .env and fill in. NEVER commit .env. Values here are placeholders only.

# ---------------------------------------------------------------- provider
# auto | gemini-api | vertex
#   auto      -> vertex when GOOGLE_CLOUD_PROJECT is set, else gemini-api
#   vertex    -> Google Cloud billing, uses Application Default Credentials
#   gemini-api-> Gemini Developer API billing, uses the key below
# Billing differs. Vertex draws on your Cloud Billing credits. The Developer API
# key bills the AI Studio account attached to that key, usually NOT the Cloud
# Billing account. See bin/c05-doctor.sh.
C05_GEMINI_PROVIDER=auto

# Model id. Must exist in the selected provider.
# Developer API: gemini-2.0-flash
# Vertex:        gemini-2.5-flash  (publisher google)  <-- LIVE VERIFIED, keep for the demo
#
# RETIREMENT RISK: gemini-2.5-flash is documented as retiring 2026-10-20.
# The hackathon deadline (2026-10-18) falls BEFORE that date, so the submission
# window is covered, but anything evaluated after 2026-10-20 breaks.
#
# gemini-3.8-flash WAS evaluated as the successor and REJECTED on measured evidence:
#   - HTTP round-trip 41s / 84s / 102s versus 5-7s for 2.5-flash
#   - returned `uncertain` with zero regions for a full tray, an empty tray AND
#     random noise, i.e. non-discriminating and indistinguishable from fallback
#   - output tokens collapsed from ~255 to ~60-88
# It remains selectable by configuration if the behaviour is re-tuned.
# GEMINI_MODEL=gemini-3.8-flash
# Verified live on project gen-lang-client-0170811162:
#   gemini-3.0-flash and gemini-flash-latest return 404 (they do not exist).
#   gemini-2.5-flash works but is documented as RETIRING 2026-10-20.
#   gemini-3.8-flash / 3.1-flash-lite / 4-argon / 3.5-flash all return 200.
# Vertex needs location=global here.
#
# Thinking control is per model family and is NOT interchangeable:
#   gemini-2.5-flash  thinkingBudget:0  -> disables thinking
#   gemini-2.5-flash  thinkingLevel     -> 400 unsupported
#   gemini-3.8-flash  thinkingBudget:0  -> HTTP 200 but SILENTLY IGNORED
#   gemini-3.8-flash  thinkingLevel:LOW -> disables thinking
#   thinkingLevel:MINIMAL               -> 400 unsupported on 3.x
# c05_gemini.thinking_config_for() picks the right one from the model id.
GEMINI_MODEL=gemini-2.5-flash

# --- path A: Gemini Developer API (only for gemini-api) -------------------
GEMINI_API_KEY=

# --- path B: Vertex AI / Google Cloud (only for vertex) -------------------
# gen-lang-client-0170811162 ("Gemini 3 hackathon") has aiplatform, run,
# firestore, artifactregistry, cloudbuild and pubsub already enabled and a
# linked billing account. gen-lang-client-01708111-bf7c8 was rejected because
# it has NO billing account linked, so services cannot be enabled there.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0170811162
C05_GEMINI_LOCATION=global

# Per-attempt timeout in seconds. Multimodal inference on a full-size tray hit
# ReadTimeout at 12.4s, so the Vertex transport enforces a floor of 90s regardless
# of this value. Google's retry guidance uses a 120s example.
# Retries: 3 attempts, jittered exponential backoff, transient statuses only (408/429/5xx).
# 150s: gemini-3.8-flash measured 14-69s per multimodal call, and Google's retry
# guidance uses a 120s canonical example. 90s left no margin over the 68s outlier.
GEMINI_TIMEOUT_SECONDS=150

# Optional thinking override. Defaults are correct per model family; set only if
# benchmarking shows a need. A malformed value degrades to the family default.
# C05_GEMINI_THINKING_LEVEL=MEDIUM
# C05_GEMINI_THINKING_CONFIG={"thinkingLevel":"LOW"}

# ---------------------------------------------------------------- pipeline
# local | cloud
C05_INSPECTION_MODE=local
C05_QUEUE_ENABLED=false
C05_GEMINI_ENABLED=true
# Synthetic data only; no writes to real production resources.
C05_DEMO_MODE=true

# ---------------------------------------------------------------- service
# Only needed when sharing one C05 dataset between processes.
C05_DB_PATH=

# ---------------------------------------------------------------- privacy
# HMAC key for reporter-contact blind indexes. Reporter phone numbers are NEVER
# stored in cleartext: we store only HMAC-SHA256(secret, digits) plus a masked
# last-4 hint. A plain hash is brute-forceable over the phone number space, so
# this must be a real secret.
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
# If unset, public intake refuses contact submissions rather than falling back
# to cleartext. Claims are retained 90 days before a purge is required.
C05_CONTACT_HMAC_SECRET=

# ---------------------------------------------------------------- frontend
# Read by apps/c05. Server-side only; never NEXT_PUBLIC_.
C05_API_BASE_URL=http://127.0.0.1:8000